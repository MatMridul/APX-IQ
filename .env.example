# APX IQ Environment Variables
# Copy to .env and fill in values

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/apxiq

# ── Cache (Redis) ─────────────────────────────────────────────────────────────
# Leave blank to use in-memory cache (data lost on restart)
REDIS_URL=redis://localhost:6379/0

# ── Networking ────────────────────────────────────────────────────────────────
UDP_PORT=20777
API_PORT=8000
INGESTION_PORT=3001

# ── CORS (comma-separated origins) ───────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://192.168.1.100:3000

# ── Intelligence / LLM ───────────────────────────────────────────────────────
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# ── Observability ─────────────────────────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=INFO
# Set LOG_FORMAT=json in production for structured logs
LOG_FORMAT=pretty

# ── Security ─────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production
