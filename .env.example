# APX IQ Environment Variables
# Copy to .env and fill in values.
# Every setting below maps to core/config.py — the single source of truth.

# ── Database ──────────────────────────────────────────────────────────────────
# Leave blank to run without PostgreSQL (in-memory storage, dev only).
DATABASE_URL=postgresql://postgres:password@localhost:5432/apxiq

# ── Cache (Redis) ─────────────────────────────────────────────────────────────
# Leave blank/unset to use in-memory cache.
REDIS_URL=redis://localhost:6379/0

# ── Networking ────────────────────────────────────────────────────────────────
UDP_PORT=20777              # F1 game telemetry listen port
API_PORT=8000               # FastAPI port
INGESTION_PORT=3001         # Socket.IO server port
# URL of the FastAPI server as seen from the INGESTION process
# (change in Docker: http://api:8000)
API_BASE_URL=http://localhost:8000

# ── CORS (comma-separated origins, or * ) ────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ── Intelligence / LLM backends ──────────────────────────────────────────────
# Report generation falls back Ollama → Gemini → template.
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# ── Observability ─────────────────────────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=INFO              # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=pretty           # pretty (dev) | json (production)

# ── Operations ────────────────────────────────────────────────────────────────
# true: ingestion silences live Socket.IO broadcasts (zero UI overhead during
# races) while still recording and persisting laps.
STEALTH_MODE=false

# ── Security ──────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production
# When set, destructive endpoints require this in the X-Admin-Key header:
#   DELETE /telemetry/laps/clear · DELETE /intelligence/reports/clear
ADMIN_API_KEY=
